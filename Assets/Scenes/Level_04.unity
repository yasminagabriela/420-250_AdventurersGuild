      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5927240246656008363, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: reward
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: speakerName
      value: Ermite du kiosque
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: rewardMessage
      value: "Tu re\xE7ois 2 Potions !"
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: "Ah... un ninja ! Personne n'\xE9tait venu jusqu'au kiosque dor\xE9
        depuis bien longtemps."
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: "Une sir\xE8ne s'est install\xE9e sur le gu\xE9 de l'\xE9tang aux fleurs.
        Son chant endort les voyageurs."
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: "Si tu tombes sous son charme, un coup peut te r\xE9veiller... Garde
        des Potions sous la main."
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: Les serpents et les champignons empoisonnent. La Purification ou un
        Antidote te sauveront.
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: 'lines.Array.data[4]'
      value: "Tiens, prends ceci. Que la lumi\xE8re de la for\xEAt te guide."
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: linesAfter.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: requiredDefeatedEnemy
      value: sirene_boss
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: 'linesAfter.Array.data[0]'
      value: "Le chant s'est tu... Tu as vaincu la sir\xE8ne !"
      objectReference: {fileID: 0}
    - target: {fileID: 8454295427366251838, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
      propertyPath: 'linesAfter.Array.data[1]'
      value: "La f\xE9e Lumi t'attend sur l'\xEEle de l'arbre rose. Va la voir."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: e66b4c6bbcb733a40b06313e45a950de, type: 3}
